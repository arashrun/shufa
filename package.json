{
  "name": "xingkai-recall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/prepare-android.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && node scripts/android-build.mjs",
    "android:keystore": "python3 scripts/create_keystore.py",
    "android:local": "bash scripts/android-local.sh",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "esbuild": "^0.27.0"
  }
}
